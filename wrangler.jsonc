{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rt117-glue-lock",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // Statiska filer (den byggda React-appen). `run_worker_first` säkerställer att
  // API- och auth-anrop alltid går till Workern och inte fångas av SPA-fallbacken.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },

  // Kopplar lock.rt117.se till Workern vid deploy (skapar DNS-post och cert
  // automatiskt — zonen rt117.se måste ligga i samma Cloudflare-konto).
  "routes": [{ "pattern": "lock.rt117.se", "custom_domain": true }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rt117-glue-lock",
      "database_id": "PLACEHOLDER_FYLLS_I_AV_WRANGLER_D1_CREATE",
      "migrations_dir": "migrations"
    }
  ],

  "observability": {
    "enabled": true
  },

  // Nattlig städning av utgångna koder, oauth-state och gamla loggrader.
  "triggers": {
    "crons": ["17 3 * * *"]
  },

  // Publika, icke-hemliga inställningar. Ändra dessa här och committa.
  // Hemligheter (inklusive BOOTSTRAP_ADMIN_EMAILS) sätts som GitHub-secrets och
  // synkas till Workern av .github/workflows/deploy.yml — se README.
  "vars": {
    "APP_URL": "https://lock.rt117.se",
    "APP_NAME": "RT117/RT36 Lokalen",
    "MAIL_FROM": "RT117 Lokalen <no-reply@rt117.se>",
    "GLUE_MOCK": "0",
    "MEMBER_SOURCE": "admin"
  }
}
