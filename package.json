{
  "name": "rt117-glue-lock",
  "version": "0.1.0",
  "private": true,
  "description": "Lås upp RT117/RT36-lokalen via hemsida — Glue smart lock + inloggning med Google eller engångskod",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "wrangler dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply rt117-glue-lock --local",
    "db:migrate": "wrangler d1 migrations apply rt117-glue-lock --remote",
    "cf:ensure-d1": "node scripts/ensure-d1.mjs",
    "cf:sync-secrets": "node scripts/sync-secrets.mjs",
    "glue:api-key": "node scripts/glue-api-key.mjs",
    "glue:locks": "node scripts/glue-locks.mjs",
    "secrets:gen": "node scripts/gen-secret.mjs"
  },
  "dependencies": {
    "hono": "^4.13.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.1",
    "@cloudflare/workers-types": "^5.20260812.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.121.0"
  }
}
